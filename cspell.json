{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "enableGlobDot": true,
  "files": [
    "**/*.{dart,js,json,md,ts,yaml,yml}"
  ],
  "ignorePaths": [
    "**/.dart_tool/**",
    "**/.firebase/**",
    "**/.gradle/**",
    "**/.idea/**",
    "**/.swiftpm/**",
    ".serena/**",
    "**/Pods/**",
    "**/assets/lottie/**",
    "**/build/**",
    "**/lib/src/gen/**",
    "**/*.freezed.dart",
    "**/*.g.dart",
    "**/*.gform.dart",
    "**/*.i18n.dart",
    "**/firebase_options*.dart",
    "**/package-lock.json",
    "**/Package.resolved"
  ],
  "ignoreRegExpList": [
    "/https?:\\/\\/\\S+/g",
    "/[0-9a-f]{20,}/gi",
    "/[A-Za-z0-9]{20,}/g"
  ],
