{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run lint && npm run test:functions",
    "test:functions": "mocha --timeout 20000 \"test/**/*.test.js\" --ignore \"test/**/*.rules.test.js\"",
    "test:rules": "mocha --timeout 20000 \"test/**/*.rules.test.js\"",
    "migrate:data": "node scripts/migrate-firestore-data.js",
    "migrate:data:apply": "node scripts/migrate-firestore-data.js --apply",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^11.7.6"
  },
  "private": true
}
