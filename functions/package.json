{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run lint && npm run test:functions",
    "test:functions": "mocha --timeout 20000 \"test/**/*.test.js\" --ignore \"test/**/*.rules.test.js\"",
    "test:rules": "mocha --timeout 20000 \"test/**/*.rules.test.js\"",
    "migrate:data": "node scripts/migrate-firestore-data.js",
    "migrate:data:apply": "node scripts/migrate-firestore-data.js --apply",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.3",
    "globals": "^17.14.0",
    "mocha": "^12.0.3"
  },
  "private": true,
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
