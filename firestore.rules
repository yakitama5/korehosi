rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.joinUids;
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.ownerUid == request.auth.uid;
    }

    // ageGroup is maintained in the server-generated participant projection.
    // Purchase documents contain surprise details and are adult-only.
    function isAdultGroupMember(groupId) {
      return isGroupMember(groupId)
        && get(
          /databases/$(database)/documents/groups/$(groupId)/participants/$(request.auth.uid)
        ).data.ageGroup == 'adult';
    }

    function isAllowedSelfUserUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let joinGroupIdsChanged = affectedKeys.hasAny(['joinGroupIds']);
      return affectedKeys.hasOnly(['name', 'joinGroupIds', 'updatedAt'])
        // Joining is handled by the callable function. A client may only remove
        // groups from its own membership list as part of the leave transaction.
        && (!joinGroupIdsChanged
          || (request.resource.data.joinGroupIds.hasOnly(resource.data.joinGroupIds)
            && request.resource.data.joinGroupIds.size()
              <= resource.data.joinGroupIds.size()));
    }

    function isAllowedGroupNameUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
    }

    function isAllowedSelfLeave() {
      let beforeUids = resource.data.joinUids;
      let afterUids = request.resource.data.joinUids;
      return request.auth.uid != resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['joinUids'])
        && request.auth.uid in beforeUids
        && !(request.auth.uid in afterUids)
        && afterUids.hasOnly(beforeUids)
        && afterUids.size() == afterUids.toSet().size()
        && afterUids.size() == beforeUids.size() - 1;
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.ageGroup in ['child', 'adult']
        && !exists(
          /databases/$(database)/documents/_dusers/$(userId)
        );
      allow read: if isSelf(userId);
      allow delete: if false;
      // ageGroup is immutable from clients so a child cannot grant themselves
      // access to adult-only purchase documents.
      allow update: if isSelf(userId) && isAllowedSelfUserUpdate();

      match /fcmTokens/{token} {
        allow read, write: if isSelf(userId);
      }

      match /notificationSettings/wishReminder {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly([
            'enabled',
            'offsetDays',
            'audience',
            'timeZone',
            'updatedAt',
          ])
          && request.resource.data.enabled is bool
          && request.resource.data.offsetDays is list
          && request.resource.data.offsetDays.hasOnly([0, 1, 7])
          && request.resource.data.offsetDays.size() <= 3
          && (!request.resource.data.enabled
            || request.resource.data.offsetDays.size() > 0)
          && request.resource.data.audience in ['adult', 'all']
          && request.resource.data.timeZone is string
          && request.resource.data.timeZone.size() > 0
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /_dusers/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.id == groupId
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.joinUids;
      allow read: if isGroupMember(groupId);
      // Client updates are limited to normal name edits and a non-owner leaving
      // the group. Joining and protected fields are updated by Admin SDK code.
      allow update: if isGroupMember(groupId)
        && (isAllowedGroupNameUpdate() || isAllowedSelfLeave());
      allow delete: if isGroupOwner(groupId);

      match /participants/{participantId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /items/{itemId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /purchases/{purchaseId} {
        allow read, write: if isAdultGroupMember(groupId);
      }

      match /messages/{messageId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /wanterNames/{nameId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /buyerNames/{nameId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /_ditems/{itemId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      match /_cpurchases/{purchaseId} {
        allow read: if isAdultGroupMember(groupId);
        allow write: if false;
      }

      match /_dpurchases/{purchaseId} {
        allow read: if isAdultGroupMember(groupId);
        allow write: if false;
      }

      match /_dmessages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }
    }

    match /_dgroups/{groupId} {
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.joinUids;
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.joinUids;
      allow update, delete: if false;
    }

    match /shareLinks/{shareLinkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.id == shareLinkId
        && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isSignedIn()
        && isGroupMember(resource.data.groupId);
    }

    // Idempotency records are created and read only by the Admin SDK.
    match /wishReminderDeliveries/{deliveryId} {
      allow read, write: if false;
    }
  }
}
